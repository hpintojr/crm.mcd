// Mercury Call Desk — Mini CRM
// Sensitive data policy: SSNs, tax IDs, raw bank numbers, and account credentials are NEVER stored here.
// GHL remains a backend integration; agents never receive GHL credentials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  SUPER_ADMIN
  SALES_MANAGER
  COMPLIANCE_MANAGER
  FINANCE_MANAGER
  AGENT
  FORMER_SERVICING_AGENT
  READ_ONLY
  HOUSE_SERVICE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AgentStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  NEEDS_CORRECTION
  APPROVED
  REJECTED
  INVITED
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum OnboardingDocType {
  SALES_AGREEMENT
  NDA_IP
  W9_PAYOUT
  ACKNOWLEDGMENT
}

enum DocStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  COMPLETED
  REJECTED
}

enum CertDecision {
  APPROVED_FOR_LIVE
  APPROVED_WITH_COACHING
  NOT_YET_APPROVED
}

enum LeadLifecycle {
  RAW
  PENDING_REVIEW
  AVAILABLE
  CLAIMED
  CONTACTED
  NURTURING
  DEMO_BOOKED
  CLOSED_WON
  CLOSED_LOST
  DISQUALIFIED
  SUPPRESSED
}

enum LeadPool {
  COLD
  OPEN
  HOT
  REFERRAL
  SHARK_TANK
  HOUSE
  NURTURE
}

enum LeadClaimAction {
  CLAIMED
  RELEASED
  REASSIGNED
  RETURNED_TO_POOL
  DENIED
}

enum LeadActivityType {
  LEAD_CREATED
  LEAD_CLAIMED
  LEAD_RELEASED
  CALL_INITIATED
  CALL_COMPLETED
  NOTE_ADDED
  DISPOSITION_SET
  CALLBACK_SCHEDULED
  CALLBACK_COMPLETED
  DNC_REQUESTED
  DEMO_BOOKED
  REASSIGNED
}

enum LeadDisposition {
  NO_ANSWER
  VOICEMAIL
  CALLBACK_REQUESTED
  QUALIFIED
  NOT_INTERESTED
  DO_NOT_CONTACT
  WRONG_NUMBER
  OUT_OF_BUSINESS
  DEMO_BOOKED
  FOLLOW_UP
}

enum LeadCallbackStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SuppressionType {
  DNC
  OPT_OUT
  INVALID_PHONE
  DUPLICATE
  COMPLIANCE_HOLD
  LEGAL_HOLD
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  role             UserRole          @default(AGENT)
  status           UserStatus        @default(INVITED)
  passwordHash     String?
  mfaEnabled       Boolean           @default(false)
  totpSecret       String?
  lastLoginAt      DateTime?
  failedLogins     Int               @default(0)
  lockedUntil      DateTime?
  agent            Agent?
  activationTokens ActivationToken[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ActivationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  purpose   String   @default("ACTIVATION")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Agent {
  id               String      @id @default(cuid())
  userId           String?     @unique
  user             User?       @relation(fields: [userId], references: [id])
  legalName        String
  companyName      String?
  preferredName    String?
  personalEmail    String      @unique
  mobile           String
  mailingAddress   String?
  emergencyContact String?
  status           AgentStatus @default(SUBMITTED)
  canClaimLeads    Boolean     @default(false)
  confirmedCallAt  DateTime?
  approvedById     String?
  approvedAt       DateTime?
  reviewNote       String?
  provisionedAt    DateTime?
  ghlContactId     String?
  ghlUserId        String?
  onboardingDocs   OnboardingDocument[]
  certifications   Certification[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([ghlContactId])
}

model OnboardingDocument {
  id            String            @id @default(cuid())
  agentId       String
  agent         Agent             @relation(fields: [agentId], references: [id])
  docType       OnboardingDocType
  version       String?
  status        DocStatus         @default(PENDING)
  ghlDocumentId String?
  r2Key         String?
  signerIp      String?
  countersigned Boolean           @default(false)
  completedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@unique([agentId, docType])
  @@index([ghlDocumentId])
}

model Certification {
  id              String       @id @default(cuid())
  agentId         String
  agent           Agent        @relation(fields: [agentId], references: [id])
  managerId       String?
  productScore    Int?
  discoveryScore  Int?
  crmScore        Int?
  complianceScore Int?
  decision        CertDecision @default(NOT_YET_APPROVED)
  signedAt        DateTime?
  createdAt       DateTime     @default(now())
}

model Lead {
  id                String        @id @default(cuid())
  company           String
  contactFirstName  String?
  contactLastName   String?
  email             String?
  businessPhone     String
  normalizedPhone   String?
  website           String?
  industry          String?
  city              String?
  state             String?
  country           String?
  timezone          String?
  source            String?
  sourceReference   String?
  score             Int           @default(0)
  lifecycle         LeadLifecycle @default(PENDING_REVIEW)
  pool              LeadPool      @default(COLD)
  ownerAgentId      String?
  claimedAt         DateTime?
  twoWayContactAt   DateTime?
  lastActionAt      DateTime?
  nextActionAt      DateTime?
  openPoolReleaseAt DateTime?
  isReferral        Boolean       @default(false)
  referralSource    String?
  suppressed        Boolean       @default(false)
  dnc               Boolean       @default(false)
  ghlContactId      String?
  ghlOpportunityId  String?
  ghlAppointmentId  String?
  packageInterest   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([pool, lifecycle, ownerAgentId])
  @@index([nextActionAt])
  @@index([openPoolReleaseAt])
  @@index([normalizedPhone])
  @@index([ghlContactId])
}

model LeadClaimEvent {
  id        String          @id @default(cuid())
  leadId    String
  agentId   String?
  action    LeadClaimAction
  reason    String?
  createdAt DateTime        @default(now())

  @@index([leadId, createdAt])
  @@index([agentId, createdAt])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  agentId     String?
  type        LeadActivityType
  disposition LeadDisposition?
  metadata    Json?
  occurredAt  DateTime         @default(now())

  @@index([leadId, occurredAt])
  @@index([agentId, occurredAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  agentId   String?
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadCallback {
  id          String             @id @default(cuid())
  leadId      String
  agentId     String?
  dueAt       DateTime
  status      LeadCallbackStatus @default(SCHEDULED)
  completedAt DateTime?
  createdAt   DateTime           @default(now())

  @@index([agentId, status, dueAt])
  @@index([leadId, status])
}

model LeadSuppression {
  id          String          @id @default(cuid())
  leadId      String?
  identifier  String
  type        SuppressionType
  reason      String?
  createdById String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  liftedAt    DateTime?

  @@index([identifier, active])
  @@index([leadId, active])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("GHL")
  ghlEventId  String   @unique
  locationId  String?
  type        String
  payload     Json
  status      String   @default("RECEIVED")
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([locationId])
}

model IntegrationError {
  id           String   @id @default(cuid())
  source       String
  refId        String?
  message      String
  payload      Json?
  resolved     Boolean  @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([source, refId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String?
  actionType  String
  entityType  String
  entityId    String?
  reason      String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}
