// Mercury Call Desk — Mini CRM
// Phase 1 domain: agents + onboarding gates + audit.
// Compliance note: SSN / raw tax IDs and raw bank numbers are NEVER stored here.
// Onboarding documents live in GHL; we keep references + completion state only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  SUPER_ADMIN
  SALES_MANAGER
  COMPLIANCE_MANAGER
  FINANCE_MANAGER
  AGENT
  FORMER_SERVICING_AGENT
  READ_ONLY
  HOUSE_SERVICE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AgentStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  NEEDS_CORRECTION
  APPROVED
  REJECTED
  INVITED
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum OnboardingDocType {
  SALES_AGREEMENT
  NDA_IP
  W9_PAYOUT
  ACKNOWLEDGMENT
}

enum DocStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  COMPLETED
  REJECTED
}

enum CertDecision {
  APPROVED_FOR_LIVE
  APPROVED_WITH_COACHING
  NOT_YET_APPROVED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  role             UserRole          @default(AGENT)
  status           UserStatus        @default(INVITED)
  passwordHash     String?
  mfaEnabled       Boolean           @default(false)
  totpSecret       String?
  lastLoginAt      DateTime?
  failedLogins     Int               @default(0)
  lockedUntil      DateTime?
  agent            Agent?
  activationTokens ActivationToken[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ActivationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  purpose   String   @default("ACTIVATION")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Agent {
  id               String      @id @default(cuid())
  userId           String?     @unique
  user             User?       @relation(fields: [userId], references: [id])

  legalName        String
  preferredName    String?
  personalEmail    String      @unique
  mobile           String
  mailingAddress   String?
  emergencyContact String?

  status           AgentStatus @default(SUBMITTED)
  canClaimLeads    Boolean     @default(false)
  confirmedCallAt  DateTime?
  approvedById     String?
  approvedAt       DateTime?
  reviewNote       String?
  provisionedAt    DateTime?

  // GHL linkage (Sales HQ). We store the backend-user + contact ids; agents never log into GHL.
  ghlContactId     String?
  ghlUserId        String?

  onboardingDocs   OnboardingDocument[]
  certifications   Certification[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([ghlContactId])
}

model OnboardingDocument {
  id            String            @id @default(cuid())
  agentId       String
  agent         Agent             @relation(fields: [agentId], references: [id])
  docType       OnboardingDocType
  version       String?
  status        DocStatus         @default(PENDING)
  ghlDocumentId String?
  r2Key         String?
  signerIp      String?
  countersigned Boolean           @default(false)
  completedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@unique([agentId, docType])
  @@index([ghlDocumentId])
}

model Certification {
  id              String       @id @default(cuid())
  agentId         String
  agent           Agent        @relation(fields: [agentId], references: [id])
  managerId       String?
  productScore    Int?
  discoveryScore  Int?
  crmScore        Int?
  complianceScore Int?
  decision        CertDecision @default(NOT_YET_APPROVED)
  signedAt        DateTime?
  createdAt       DateTime     @default(now())
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("GHL")
  ghlEventId  String   @unique
  locationId  String?
  type        String
  payload     Json
  status      String   @default("RECEIVED")
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([locationId])
}

model IntegrationError {
  id         String   @id @default(cuid())
  source     String
  refId      String?
  message    String
  payload    Json?
  resolved   Boolean  @default(false)
  resolvedAt DateTime?
  resolvedById String?
  createdAt  DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([source, refId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String?
  actionType  String
  entityType  String
  entityId    String?
  reason      String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}
