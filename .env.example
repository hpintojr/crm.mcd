# ───────────────────────────────────────────────────
# Mercury Call Desk — Mini CRM · production environment template
# Configure these values in Vercel. NEVER commit real secrets.
# ───────────────────────────────────────────────────

APP_URL="https://crm.mercurycalldesk.com"
APP_NAME="Mercury Call Desk"

# Auth.js — required in production.
AUTH_SECRET=""
AUTH_URL="https://crm.mercurycalldesk.com"
AUTH_TRUST_HOST="true"

# Optional server-only diagnostic progress logs. Keep false unless actively investigating a route.
ROUTE_TRACE_ENABLED="false"

# Neon / PostgreSQL. Use the pooled runtime URL and direct migration URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# GoHighLevel backend — never expose these to the browser.
GHL_PRIVATE_TOKEN=""
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"
GHL_SALES_HQ_LOCATION_ID=""
GHL_ALLOWED_LOCATION_IDS=""
GHL_WEBHOOK_SECRET=""

# Onboarding packet coordinator (Option B) — OFF by default. Sends all four onboarding
# documents via GHL's Send Template API and, only if every one succeeds, one CRM email
# with all four secure links. Not called anywhere in the codebase yet. Do not set this to
# true in production until: (1) a live GHL Send Template response has been inspected to
# confirm the document-id/signing-url field mapping in src/lib/ghl-documents.ts, and
# (2) the native "Agent Onboarding Documents" GHL workflow's four Send Document actions
# are disabled/unpublished so applicants don't receive both the native emails and this
# one. See docs/ONBOARDING_PACKET_COORDINATOR.md.
ONBOARDING_PACKET_COORDINATOR_ENABLED="false"
GHL_TEMPLATE_ID_SALES_AGREEMENT=""
GHL_TEMPLATE_ID_NDA_IP=""
GHL_TEMPLATE_ID_W9_PAYOUT=""
GHL_TEMPLATE_ID_ACKNOWLEDGMENT=""

# Cloudflare R2 private signed-document mirror.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Server-side company email access.
EMAIL_ACCESS_TOKEN=""
EMAIL_IMAP_HOST="imap.ionos.com"

# Outbound transactional email (activation links, etc.) via the IONOS mailbox.
# All four must be set for real delivery; if EMAIL_SMTP_USER/PASSWORD are blank,
# sendMail() runs in stub mode and no email is sent (safe for local/dev).
EMAIL_SMTP_HOST="smtp.ionos.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM_ADDRESS="no-reply@mercurycalldesk.com"
EMAIL_FROM_NAME="Mercury Call Desk"

# Stripe Connect integration.
PAYOUT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""

# Stage database-backed modules only after migration + controlled production test.
LEADS_ENABLED="false"
LEAD_CLAIM_CAPACITY="50"
OPEN_POOL_RELEASE_DAYS="45"
COMMISSIONS_ENABLED="false"
SERVICING_ENABLED="false"
FINANCE_ENABLED="false"

# No SSN, raw tax ID, or raw bank details are ever stored in the CRM.
