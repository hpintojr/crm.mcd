# ─────────────────────────────────────────────────────────────
# Mercury Call Desk — Mini CRM · environment template
# Copy to .env.local for development. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
APP_URL="http://localhost:3000"
APP_NAME="Mercury Call Desk"

# Auth.js (server-only). Generate AUTH_SECRET with `npx auth secret` or a secure
# 32-byte random value. AUTH_URL is the public app URL in production.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Database (Neon / PostgreSQL). Use a pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# GoHighLevel (backend). API v2 Private Integration Token — SERVER ONLY.
GHL_PRIVATE_TOKEN=""
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"
# The "Sales HQ" sub-account (location) where agent contacts/users live.
GHL_SALES_HQ_LOCATION_ID=""
# Inbound webhook shared secret (GHL -> MiniCRM). Verify on every inbound event.
GHL_WEBHOOK_SECRET=""

# Cloudflare R2 (private bucket for signed-document mirror / 7-year record) — SERVER ONLY.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Company email access (IONOS). Agents NEVER log in directly — the CRM accesses mailboxes
# server-side using this token. SERVER ONLY. Never expose to the client.
EMAIL_ACCESS_TOKEN=""
EMAIL_IMAP_HOST="imap.ionos.com"
EMAIL_SMTP_HOST="smtp.ionos.com"

# Payout provider (Stripe or bill.com). CRM stores a token/reference only — never raw bank data.
PAYOUT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""

# NOTE: SSN / tax IDs are NEVER stored as a field here. They are captured only inside the
# W-9 e-sign document (GHL Documents & Contracts) and retrieved from that signed PDF.
